# simplefactuapp · Vercel Preview (QA)
# Dominio: https://qa.simplefactu.com · rama: develop
# Copiar valores a Vercel → Project Settings → Environment Variables → Preview
# Backup: Bitwarden Secure Note «simplefactu · App QA · Vercel Preview»
#
# Emparejamiento API QA (VPS hetzner):
#   SIMPLEFACTU_ADMIN_KEY  =  ADMIN_KEY  en /opt/simplefactu/deploy/.env (QA)
#   SIMPLEFACTU_API_BASE_URL  =  https://api.qa.simplefactu.com/v1

DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Clerk TEST (Preview)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_CHANGE_ME
CLERK_SECRET_KEY=sk_test_CHANGE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/invoices
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/welcome

SIMPLEFACTU_API_BASE_URL=https://api.qa.simplefactu.com/v1
SIMPLEFACTU_DOCS_API_BASE_URL=https://api.qa.simplefactu.com/v1
SIMPLEFACTU_ADMIN_KEY=CHANGE_ME_SAME_AS_QA_VPS_ADMIN_KEY
VERIFACTU_ENCRYPTION_KEY=CHANGE_ME_QA_BASE64_32_BYTES

# Opcional: panel /admin y /partner
# ADMIN_CLERK_USER_IDS=
# PARTNER_CLERK_USER_IDS=

# Sandbox QA: otorgar rol partner al elegir integrador (sin cola de aprobación).
SANDBOX_AUTO_APPROVE_INTEGRATORS=true
NEXT_PUBLIC_SANDBOX_URL=https://qa.simplefactu.com

# Resend (opcional en QA)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Simple*Factu <noreply@qa.simplefactu.com>

# --- Billing QA (Lemon Squeezy TEST mode) ---
# 1) LS Dashboard → activar Test mode → producto Pro mensual EUR
# 2) Webhook → https://qa.simplefactu.com/api/webhooks/lemonsqueezy
# 3) API VPS QA: BILLING_ENABLED=true + docker compose up -d
# 4) Neon QA: pnpm prisma migrate deploy (tabla subscriptions)
# Guía: docs/BILLING_QA.md

NEXT_PUBLIC_BILLING_ENABLED=true
NEXT_PUBLIC_APP_URL=https://qa.simplefactu.com

# API key de TEST mode (no la live)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID_PRO=
# Signing secret del webhook apuntando a qa.simplefactu.com
LEMONSQUEEZY_WEBHOOK_SECRET=
# Fuerza checkouts en test mode (recomendado en Preview)
LEMONSQUEEZY_TEST_MODE=true
