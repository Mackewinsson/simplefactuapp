# simplefactuapp · desarrollo local
# Copiar: cp .env.example .env.local
#
# Desarrollo contra QA (misma Neon que Preview; dos modos):
#   cd ../simplefactu && ./scripts/sync-local-env-from-qa.sh
#
#   Modo A — front + API desplegada (qa.simplefactu.com, sin túnel):
#     .env.local  →  pnpm dev:qa
#
#   Modo B — stack local (mismo Postgres QA vía túnel + API en :3000):
#     .env.local.stack  →  pnpm dev:stack
#     (antes: npm run tunnel:qa + npm run dev en simplefactu)
#
# Vercel QA/prod: ver .env.qa.example y .env.prod.example (referencia Bitwarden / panel Vercel).

DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_CHANGE_ME
CLERK_SECRET_KEY=sk_test_CHANGE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/invoices
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/invoices

# Panel /admin (opcional): IDs de Clerk separados por coma. Alternativa: publicMetadata.role = "admin"
# ADMIN_CLERK_USER_IDS=user_xxxxxxxx
# Partner panel (/partner): allowlist or publicMetadata.role = "partner"
# PARTNER_CLERK_USER_IDS=user_xxxxxxxx

SIMPLEFACTU_API_BASE_URL=http://localhost:3000/v1
SIMPLEFACTU_ADMIN_KEY=dev-admin-key-change-me
VERIFACTU_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES

# Docs playground — always points to QA so "Try it" never hits prod.
# Only needed in the production Vercel environment.
# SIMPLEFACTU_DOCS_API_BASE_URL=https://api.qa.simplefactu.com/v1

# Resend — emails transaccionales (notificaciones de factura al usuario)
# Obtén tu API key en resend.com/api-keys
# Si no se define RESEND_API_KEY, el envío de emails se deshabilita silenciosamente.
RESEND_API_KEY=re_CHANGE_ME
RESEND_FROM_EMAIL=Simple*Factu <noreply@tudominio.com>

# Las alertas de jobs DEAD y la sonda /ready se configuran en el VPS (API).
# Ver content/docs/monitorizacion.md y simplefactu/docs/RUNBOOK.md

# --- Billing (Lemon Squeezy) — off by default ---
# NEXT_PUBLIC_BILLING_ENABLED=false
# NEXT_PUBLIC_APP_URL=http://localhost:3001
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_VARIANT_ID_PRO=
# LEMONSQUEEZY_WEBHOOK_SECRET=
# LEMONSQUEEZY_TEST_MODE=true
