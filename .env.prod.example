# simplefactuapp · Vercel Production
# Dominio: https://simplefactu.com · rama: main
# Copiar valores a Vercel → Project Settings → Environment Variables → Production
# Backup: Bitwarden Secure Note «simplefactu · App Prod · Vercel Production»
#
# Emparejamiento API Prod (VPS hetzner_prod):
#   SIMPLEFACTU_ADMIN_KEY  =  ADMIN_KEY  en /opt/simplefactu/deploy/.env (Prod)
#   SIMPLEFACTU_API_BASE_URL  =  https://api.simplefactu.com/v1
#
# Nota docs: el playground puede apuntar a QA para evitar operaciones sobre prod.

DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Clerk LIVE (Production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_CHANGE_ME
CLERK_SECRET_KEY=sk_live_CHANGE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/invoices
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/welcome

SIMPLEFACTU_API_BASE_URL=https://api.simplefactu.com/v1
SIMPLEFACTU_DOCS_API_BASE_URL=https://api.qa.simplefactu.com/v1
SIMPLEFACTU_ADMIN_KEY=CHANGE_ME_SAME_AS_PROD_VPS_ADMIN_KEY
VERIFACTU_ENCRYPTION_KEY=CHANGE_ME_PROD_BASE64_32_BYTES

# Opcional: panel /admin y /partner
# ADMIN_CLERK_USER_IDS=
# PARTNER_CLERK_USER_IDS=

# Producción: NO auto-aprobar integradores (deben solicitar en /partner/activation).
# SANDBOX_AUTO_APPROVE_INTEGRATORS=false
NEXT_PUBLIC_SANDBOX_URL=https://qa.simplefactu.com
# ADMIN_NOTIFY_EMAIL=ops@simplefactu.com

RESEND_API_KEY=
RESEND_FROM_EMAIL=Simple*Factu <noreply@simplefactu.com>

# --- Billing Production (Lemon Squeezy LIVE mode) ---
NEXT_PUBLIC_BILLING_ENABLED=true
NEXT_PUBLIC_APP_URL=https://simplefactu.com

# API key de LIVE mode
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID_PRO=
# Signing secret del webhook apuntando a simplefactu.com
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_TEST_MODE=false
